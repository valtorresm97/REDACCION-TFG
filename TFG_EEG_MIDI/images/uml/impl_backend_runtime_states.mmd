%%{init: {"theme": "base", "themeVariables": {"fontSize": "20px", "fontFamily": "Arial", "primaryBorderColor": "#333333", "lineColor": "#333333"}, "state": {"nodeSpacing": 28, "rankSpacing": 36, "padding": 6}}}%%
stateDiagram-v2
  state "Arranque" as boot
  state "Espera Linux" as waiting_linux
  state "Streaming" as streaming
  state "Llenando ventana" as filling_window
  state "Features listas" as features_ready
  state "Ventana usable" as usable
  state "Atenuar / cautela" as caution
  state "Bloqueada" as blocked
  state "Error" as error

  [*] --> boot
  boot --> waiting_linux: backend + WebUI
  waiting_linux --> streaming: linux_started
  streaming --> filling_window: primer bloque
  filling_window --> features_ready: window_ready

  features_ready --> usable: clean
  features_ready --> caution: caution / artifact
  features_ready --> blocked: bad

  usable --> streaming: siguiente hop
  caution --> streaming: siguiente hop
  blocked --> filling_window: esperar ventana útil

  streaming --> error: RX / Bridge
  features_ready --> error: feature / quality
  error --> [*]
