%%{init: {"theme": "base", "themeVariables": {"fontSize": "22px", "fontFamily": "Arial", "primaryBorderColor": "#333333", "lineColor": "#333333"}, "sequence": {"useMaxWidth": true, "showSequenceNumbers": true, "mirrorActors": false, "diagramMarginX": 18, "diagramMarginY": 12, "actorMargin": 38, "boxMargin": 8, "noteMargin": 8, "messageMargin": 28}}}%%
sequenceDiagram
  participant BE as BackendService
  participant PD as Processor<br/>DSPCore
  participant Q as Quality
  participant AD as Adapter
  participant MUS as Segment<br/>Bar<br/>Notes
  participant SCH as Scheduler
  participant TR as Transport<br/>Bridge
  participant HW as Firmware<br/>UART

  BE->>PD: is_window_ready(4 s)
  alt ventana lista + hop 64 muestras
    BE->>PD: compute_live_features(CH1, multitaper)
    PD-->>BE: features + diagnostics
    BE->>Q: compute_spectral_quality(...)
    Q-->>BE: score + state + gate
    BE->>AD: update(features, quality)
    AD-->>BE: SonificationFeatures 0..1
  end

  alt sonificación válida + periodo de compás
    BE->>MUS: build_live_segment(scale, main note)
    MUS-->>BE: MusicSegment
    BE->>MUS: generate_live_bar(segment)
    MUS-->>BE: Bar
    BE->>MUS: generate_notes_for_bar(segment, bar)
    MUS-->>BE: NoteEvent list
    BE->>SCH: schedule_program_change once
    BE->>SCH: schedule_notes(notes, time_origin)
    BE->>BE: recent_notes para WebUI
  else ventana no fiable
    BE->>BE: no generar nuevo compás
  end

  BE->>SCH: pop_due_events(now, lookahead)
  SCH-->>BE: MidiLiveEvent list
  BE->>TR: send_events(due_events)

  loop cada evento MIDI
    TR->>TR: event_to_midi_bytes(event)
    TR->>HW: midi_bytes(n, b0, b1, b2)
    HW->>HW: Serial1/D1 · MIDI baud
  end

  opt Panic MIDI
    BE->>SCH: panic()
    SCH-->>BE: All Sound Off + All Notes Off
    BE->>TR: send_events(panic events)
  end
